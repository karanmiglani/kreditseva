# Server
NODE_ENV=production
PORT=3000

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=false
# Auth — use a long random string; no quotes or leading spaces
JWT_SECRET_KEY=

# Optional: extra CORS origins, comma-separated
# CORS_ORIGIN=https://staging.kreditseva.com

# Optional: bump on deploy to bust browser cache for CSS/JS (auto-set on restart if omitted)
# ASSET_VERSION=20250624

# Cloudflare Turnstile (apply-now /save-lead)
# Site key is public (frontend). Secret stays server-only — never commit it.
# TURNSTILE_SECRET=your_widget_secret_from_cloudflare_dashboard
# Comma-separated frontend hostnames returned by siteverify (no spaces needed)
# Production example: kreditseva.com,www.kreditseva.com
# Local testing: add localhost,127.0.0.1 here AND on the widget domains in Cloudflare
# TURNSTILE_HOSTNAMES=kreditseva.com,www.kreditseva.com
